# Rappels push « séance dans 1 h » (docs/push.md). Même jeton que la purge : /etc/coachos/purge.header (root:coachos, 0640).
[Unit]
Description=Matnexa - rappels de seance
Wants=network-online.target
After=network-online.target coachos.service

[Service]
Type=oneshot
User=coachos
ExecStart=/usr/bin/curl -fsS --max-time 60 -X POST -H @/etc/coachos/purge.header http://127.0.0.1:3400/api/cron/reminders
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
