# Coach OS — exemple de configuration. Copiez vers .env.local (jamais versionné) et renseignez vos valeurs.
# Aucune valeur secrète ne doit être commitée. Voir docs/setup.md.

# URL publique de l'application (https obligatoire en production). Sert aux liens des e-mails et d'invitation.
SITE_URL=http://localhost:4747

# Supabase (API Auth). Clé « publishable » / anon uniquement : JAMAIS la clé service_role.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Connexion PostgreSQL du rôle `app_server` (voir docs/setup.md pour créer son mot de passe).
# Production : utiliser l'URL du pooler transactionnel (Supavisor, port 6543), SSL activé.
DATABASE_URL=postgresql://app_server:CHANGE_ME@127.0.0.1:54322/postgres
# Mettre "disable" uniquement pour une base locale sans SSL.
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10

# Secret aléatoire d'au moins 32 caractères (pseudonymisation des compteurs anti-abus). Générer : openssl rand -base64 48
APP_SECRET=

# Libellé de l'environnement (staging | production), lu par `npm run pilot:preflight`.
APP_ENV=staging

# Durée de vie d'un QR de pointage en secondes (10-300). Défaut : 90. Ne pas modifier sans raison.
CHECKIN_TOKEN_TTL_SECONDS=

# Jeton de la tâche planifiée de purge de rétention (facultatif, 32+ caractères). Sans lui, /api/cron/purge est désactivée.
CRON_SECRET=
