# Matnexa (nom de code interne : coachos) — exemple de configuration. Copiez vers .env.local (jamais versionné) et renseignez vos valeurs.
# Aucune valeur secrète ne doit être commitée. Voir docs/setup.md et docs/self-hosted-auth.md.

# URL publique EXACTE de l'application (https obligatoire en production). Origine de confiance de l'authentification,
# liens des e-mails et d'invitation. Doit correspondre à l'URL servie par le reverse proxy.
SITE_URL=http://localhost:4747

# Connexion PostgreSQL du rôle `app_server` (données métier, protégées par la RLS). Mot de passe créé hors Git (docs/setup.md).
# Connexion distante : ajouter ?sslmode=require. Mettre DATABASE_SSL=disable uniquement pour une base locale sans SSL.
DATABASE_URL=postgresql://app_server:CHANGE_ME@127.0.0.1:5432/coachos
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10

# Connexion PostgreSQL du rôle `auth_runtime` (tables d'authentification uniquement). Rôle DIFFÉRENT d'app_server.
AUTH_DATABASE_URL=postgresql://auth_runtime:CHANGE_ME@127.0.0.1:5432/coachos

# Migrations (NE PAS mettre dans l'environnement du service) : `MIGRATION_DATABASE_URL=…` est l'URL d'un rôle ADMINISTRATEUR, fournie
# seulement au moment de `npm run db:migrate` et du préflight. Voir docs/setup.md.

# Deux secrets aléatoires DISTINCTS d'au moins 32 caractères. Générer : openssl rand -base64 48
# APP_SECRET pseudonymise IP et e-mails dans les compteurs anti-abus et dans les sessions.
APP_SECRET=
# BETTER_AUTH_SECRET signe les cookies de session. Ne JAMAIS le stocker avec la base ni ses sauvegardes ;
# sa fuite avec une copie de la base permettrait de forger des sessions (voir docs/self-hosted-auth.md).
BETTER_AUTH_SECRET=

# E-mails transactionnels : `resend` (staging, production) ou `outbox` (développement et tests UNIQUEMENT : les liens de
# confirmation et de réinitialisation sont écrits EN CLAIR dans un fichier, rien n'est envoyé). Le serveur REFUSE de démarrer avec
# `outbox` si APP_ENV=staging|production, ou si SITE_URL n'est pas locale (localhost / 127.0.0.1).
MAIL_PROVIDER=outbox
MAIL_OUTBOX_FILE=./.dev-outbox.jsonl
# Avec MAIL_PROVIDER=resend : clé API (gestionnaire de secrets, jamais dans Git) et expéditeur d'un domaine vérifié.
# RESEND_API_KEY=
# MAIL_FROM=Matnexa <no-reply@votre-domaine>

# Rôle EXPLICITE de cette instance (obligatoire, aucune valeur par défaut) : development | test | staging | production.
# Ne se déduit pas de NODE_ENV. Une instance déployée (staging, production) exige MAIL_PROVIDER=resend ; production exige https.
# Lu au démarrage (le serveur refuse de démarrer si la configuration est interdite) et par `npm run pilot:preflight`.
APP_ENV=development

# Durée de vie d'un QR de pointage en secondes (10-300). Défaut : 90. Ne pas modifier sans raison.
CHECKIN_TOKEN_TTL_SECONDS=

# Jeton de la tâche planifiée de purge de rétention (facultatif, 32+ caractères). Sans lui, /api/cron/purge est désactivée.
CRON_SECRET=

# Notifications push (facultatif). Générer les clés une fois : node scripts/generate-vapid.mjs. Les trois ensemble, ou aucune (fonction désactivée).
# VAPID_SUBJECT : contact du service (mailto:... ou https://...). Ne jamais changer les clés une fois les appareils abonnés (ils devraient se réabonner).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# HSTS (émis UNIQUEMENT par l'application, jamais par Nginx). Actif seulement si APP_ENV=staging|production ET SITE_URL en https.
# Défaut prudent : 86400 s (production), 300 s (staging). Plafond 31536000. 0 = pas d'en-tête (retour arrière).
# Jamais includeSubDomains ni preload. Ne monter qu'après validation HTTPS en préproduction.
# HSTS_MAX_AGE_SECONDS=86400

# Administrateur de la plateforme (OBLIGATOIRE en staging et production) : reçoit les demandes de création de club et est le seul à pouvoir les
# approuver ; peut créer son compte sans code de club. Valeur lue uniquement par le serveur : jamais en base, jamais affichée, jamais journalisée.
# PLATFORM_ADMIN_EMAIL=
